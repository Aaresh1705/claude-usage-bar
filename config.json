{
  "refresh_seconds": 60,
  "primary_metric": "session",
  "secondary_metric": "weekly_all",
  "icon": {
    "style": "bar_text",
    "orientation": "horizontal",
    "margin": 1,
    "corner_radius": 2,
    "track_color": "#4A4A4A",
    "track_alpha": 200,
    "text_color": "#FFFFFF",
    "text_shadow": true,
    "font_file": "segoeuib.ttf",
    "font_scale": 0.78,
    "bar_thickness": 0.3,
    "ring_thickness": 0.22,
    "show_secondary": true,
    "secondary_thickness": 0.14,
    "secondary_color": "#7A7AFF",
    "gap": 0.08,
    "supersample": 8,
    "skull_at": 100,
    "count": 0,
    "reverse_segments": true,
    "label_format": "{pct}",
    "segment_mode": "cells",
    "segments": [
      "text",
      "bar",
      "bar",
      "bar",
      "bar",
      "bar"
    ]
  },
  "thresholds": [
    {
      "at": 0,
      "color": "#22C55E"
    },
    {
      "at": 60,
      "color": "#F59E0B"
    },
    {
      "at": 85,
      "color": "#EF4444"
    }
  ],
  "tooltip_template": "Claude \u00b7 {primary_label}: {primary}%\n{secondary_label}: {secondary}%\nResets {primary_reset_short} (in {primary_reset_in})",
  "notifications": {
    "enabled": true,
    "at": [
      80,
      95
    ],
    "metric": "session"
  },
  "flyout": {
    "width": 320,
    "theme": "auto",
    "accent": "auto",
    "corner_offset": [
      12,
      12
    ],
    "close_on_focus_loss": true
  },
  "left_click": "flyout",
  "usage_page_url": "https://claude.ai/settings/usage",
  "tray": {
    "enabled": false
  },
  "taskbar_widget": {
    "enabled": true,
    "metric": null,
    "corner": "left",
    "width": 128,
    "offset": [
      8,
      0
    ],
    "padding": 5,
    "text_color": "auto",
    "muted_color": "auto",
    "font_file": "segoeui.ttf",
    "bold_font_file": "segoeuib.ttf",
    "show_bar": true,
    "show_reset": true,
    "bar_height": 4,
    "supersample": 3,
    "background": "transparent",
    "corner_radius": 6,
    "background_alpha": 255
  }
}