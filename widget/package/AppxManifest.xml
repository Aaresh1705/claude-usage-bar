<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity
    Name="ClaudeUsageWidget"
    Publisher="CN=Claude Usage Bar"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Claude Usage Widget</DisplayName>
    <PublisherDisplayName>Claude Usage Bar</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="ClaudeUsageWidget\ClaudeUsageWidget.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Claude Usage Widget"
        Description="Live Claude usage limits on the Windows widgets board."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- Lets the widget host COM-activate the provider. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="ClaudeUsageWidget\ClaudeUsageWidget.exe" DisplayName="Claude Usage Widget">
              <com:Class Id="7ec0070b-4b01-4f2f-aeca-9eaa2b9aabf5" DisplayName="Claude Usage Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets"
                             DisplayName="Claude Usage"
                             Id="ClaudeUsageWidgetApp"
                             PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="ProviderAssets\ClaudeUsage_Icon.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="7ec0070b-4b01-4f2f-aeca-9eaa2b9aabf5" />
                </Activation>
                <Definitions>
                  <Definition Id="Claude_Usage_Widget"
                              DisplayName="Claude usage"
                              Description="Session and weekly limits, with reset countdowns."
                              AllowMultiple="false">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="ProviderAssets\ClaudeUsage_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="ProviderAssets\ClaudeUsage_Screenshot.png"
                                    DisplayAltText="Claude usage widget showing session and weekly limits" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
